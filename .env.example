# Copy to .env. NPM/TLS settings are managed separately.
RELAY_BIND_IP=0.0.0.0
RELAY_PORT=8080
RELAY_RETENTION_DAYS=7
# Denied Minecraft UUIDs, comma-separated. Empty means no explicitly banned UUIDs.
# This is NOT a whitelist; a group code and account verification are still required.
RELAY_DENIED_UUIDS=
